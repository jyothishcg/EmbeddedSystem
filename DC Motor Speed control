// Motor Direction Pins
#define m1 6  // Right Motor MA1
#define m2 5  // Right Motor MA2
#define m3 4  // Left Motor MB1
#define m4 3  // Left Motor MB2

// Motor Speed (PWM) Pins
#define e1 9  // Right Motor Enable Pin EA
#define e2 10 // Left Motor Enable Pin EB

// Ultrasonic Pins
#define trigPin 11
#define echoPin 12

long duration;
int distance;

void setup() {
  // Setup Motors
  pinMode(m1, OUTPUT); pinMode(m2, OUTPUT);
  pinMode(m3, OUTPUT); pinMode(m4, OUTPUT);
  pinMode(e1, OUTPUT); pinMode(e2, OUTPUT);
  
  // Setup Sensor
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
  
  // Initialize Serial Communication at 9600 bits per second
  Serial.begin(9600);
  Serial.println("Robot Initialized. Reading distance...");
}

void loop() {
  distance = calculateDistance();

  // Print the distance to the Serial Monitor
  Serial.print("Distance: ");
  Serial.print(distance);
  Serial.println(" cm");

  // --- HUMAN FOLLOWING LOGIC ---
  if (distance > 30 && distance < 60) {
    Serial.println("Status: Following Human");
    forward(150); 
  } 
  else if (distance <= 10 && distance > 1) {
    Serial.println("Status: Too Close! Backing up");
    backward(130);
  }
  else {
    Serial.println("Status: Waiting / Out of range");
    stopRobot();
  }
  
  delay(100); // Slight delay so the serial monitor is readable
}

int calculateDistance() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  
  duration = pulseIn(echoPin, HIGH);
  // Distance calculation formula
  int result = duration * 0.034 / 2;
  return result;
}

// --- MOVEMENT FUNCTIONS ---
void forward(int speed) {
  analogWrite(e1, speed); analogWrite(e2, speed);
  digitalWrite(m1, HIGH); digitalWrite(m2, LOW);
  digitalWrite(m3, HIGH); digitalWrite(m4, LOW);
}

void backward(int speed) {
  analogWrite(e1, speed); analogWrite(e2, speed);
  digitalWrite(m1, LOW);  digitalWrite(m2, HIGH);
  digitalWrite(m3, LOW);  digitalWrite(m4, HIGH);
}

void stopRobot() {
  digitalWrite(m1, LOW); digitalWrite(m2, LOW);
  digitalWrite(m3, LOW); digitalWrite(m4, LOW);
}
